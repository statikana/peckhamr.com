# /etc/magic-backend.env
# Permissions: chmod 0600 /etc/magic-backend.env && chown root:root /etc/magic-backend.env
# Read by systemd via EnvironmentFile=/etc/magic-backend.env before dropping privileges to User=magic.

# HTTP bind address and port (keep 127.0.0.1; cloudflared connects locally)
HOST=127.0.0.1
PORT=8787

# SQLite database path on the home server (directory owned by magic:magic, mode 0700)
MAGIC_SQLITE_PATH=/var/lib/magic-backend/magic.sqlite

# Shared secret verified against X-Magic-Proxy-Secret (must match `wrangler secret put MAGIC_PROXY_SECRET`)
# Generate with: openssl rand -hex 32
MAGIC_PROXY_SECRET=replace-with-openssl-rand-hex-32

# OAuth credentials read via getEnvVar in src/routes/magic/api/auth/+server.ts
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Optional maintenance mode: set to 1 to make POST requests return 503 while exporting SQLite -> D1
MAGIC_READ_ONLY=0
